        "grdavies/shipwright",
        "grdavies/planning"
      ],
      "allowedProjectIds": [
        "shipwright"
      ],
      "allowedEndpoints": [
        "https://api.github.com"
      ],
      "tokenEnv": "SW_PLANNING_ISSUES_TOKEN"
    }
