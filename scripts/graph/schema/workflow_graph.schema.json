{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipwright.dev/schemas/graph/workflow_graph.schema.json",
  "title": "Shipwright WorkflowGraph",
  "description": "Version 1 alpha runtime intermediate representation for a Shipwright workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "shipwright.dev/v1alpha1"
    },
    "kind": {
      "const": "WorkflowGraph"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "phaseId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "resourceLimits",
        "verification"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "https://shipwright.dev/schemas/graph/node_spec.schema.json"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "resourceLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxConcurrency",
            "maxDurationSeconds"
          ],
          "properties": {
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "maxDurationSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "failClosed"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "failClosed": {
              "const": true
            }
          }
        }
      }
    }
  }
}
