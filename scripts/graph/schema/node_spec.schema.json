{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipwright.dev/schemas/graph/node_spec.schema.json",
  "title": "Shipwright NodeSpec",
  "description": "Version 1 alpha node definition for the WorkflowGraph runtime IR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "resources",
    "isolation",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool",
        "slots",
        "timeoutSeconds"
      ],
      "properties": {
        "pool": {
          "enum": [
            "code-writers",
            "read-only-reviewers",
            "web-research",
            "provider-api"
          ]
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "writeScope"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "process",
            "worktree",
            "container",
            "remote"
          ]
        },
        "writeScope": {
          "enum": [
            "none",
            "read-only",
            "scoped",
            "worktree"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "strategy"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "strategy": {
          "enum": [
            "mechanical",
            "evidence",
            "judgment",
            "synthesis"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purity": {
          "enum": [
            "read-only",
            "mutating"
          ]
        },
        "cache": {
          "enum": [
            "content-addressed",
            "disabled"
          ]
        },
        "templateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trustDomain": {
              "type": "string",
              "minLength": 1
            },
            "repositoryIdentity": {
              "type": "string",
              "minLength": 1
            },
            "toolBinaryIdentity": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
