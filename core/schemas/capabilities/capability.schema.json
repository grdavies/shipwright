{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grdavies/shipwright/core/schemas/capabilities/capability.schema.json",
  "title": "Shipwright platform capability descriptor",
  "description": "Full semantic resolution protocol for host adapters (PRD 349 R15–R17).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "surface",
    "version_range",
    "os_scope",
    "adapter_id",
    "declared_at",
    "trust_level",
    "capabilities"
  ],
  "properties": {
    "host": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "string",
      "enum": ["cli", "desktop", "cloud", "ide", "api"]
    },
    "version_range": { "type": "string", "minLength": 1 },
    "os_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["mac", "linux", "windows"] },
      "uniqueItems": true
    },
    "adapter_id": { "type": "string", "minLength": 1 },
    "declared_at": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 },
    "tested_at": { "type": "string", "minLength": 1 },
    "trust_level": {
      "type": "string",
      "enum": ["declared", "observed", "tested"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "load_context",
        "invoke_workflow",
        "inspect_tool_call",
        "block_action",
        "dispatch_reviewer",
        "capture_progress",
        "restore_state",
        "emit_hook",
        "resolve_instruction"
      ],
      "properties": {
        "load_context": { "$ref": "#/$defs/operation" },
        "invoke_workflow": { "$ref": "#/$defs/operation" },
        "inspect_tool_call": { "$ref": "#/$defs/operation" },
        "block_action": { "$ref": "#/$defs/operation" },
        "dispatch_reviewer": { "$ref": "#/$defs/operation" },
        "capture_progress": { "$ref": "#/$defs/operation" },
        "restore_state": { "$ref": "#/$defs/operation" },
        "emit_hook": { "$ref": "#/$defs/operation" },
        "resolve_instruction": { "$ref": "#/$defs/operation" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trust_level": { "const": "tested" } },
        "required": ["trust_level"]
      },
      "then": { "required": ["tested_at"] }
    },
    {
      "if": {
        "properties": { "trust_level": { "const": "observed" } },
        "required": ["trust_level"]
      },
      "then": { "required": ["observed_at"] }
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_mode",
        "evidence_required",
        "known_gaps",
        "failure_behavior"
      ],
      "properties": {
        "implementation_mode": {
          "type": "string",
          "enum": ["native", "adapted", "explicit", "unsupported"]
        },
        "evidence_required": { "type": "string" },
        "known_gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failure_behavior": { "type": "string", "minLength": 1 }
      }
    }
  }
}
