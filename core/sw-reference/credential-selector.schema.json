{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/grdavies/shipwright/.sw/credential-selector.schema.json",
  "title": "Shipwright machine-local credential selector",
  "description": "User-owned selector document mapping credential references to backends and scope. No secret-valued properties.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/selectorEntry"
      }
    }
  },
  "definitions": {
    "backendType": {
      "type": "string",
      "enum": ["environment", "github_cli", "git_credential", "keystore"]
    },
    "scopeList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "provider",
        "allowedRepos",
        "allowedProjectIds",
        "allowedEndpoints"
      ],
      "properties": {
        "backend": {
          "$ref": "#/definitions/backendType"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "tokenEnv": {
          "type": "string",
          "minLength": 1
        },
        "allowedRepos": {
          "$ref": "#/definitions/scopeList"
        },
        "allowedProjectIds": {
          "$ref": "#/definitions/scopeList"
        },
        "allowedEndpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["token"] },
          { "required": ["secret"] },
          { "required": ["password"] },
          { "required": ["apiKey"] },
          { "required": ["value"] }
        ]
      }
    }
  }
}
