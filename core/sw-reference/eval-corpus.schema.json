{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grdavies/shipwright/core/sw-reference/eval-corpus.schema.json",
  "title": "EvalCorpus@v1",
  "description": "Versioned external-consumer evaluation corpus manifest (PRD 333 R1, R13, R14). Secret-free fixtures with holdout isolation and planning-store mode coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "manifestId",
    "compositionRules",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "EvalCorpus@v1"
    },
    "corpusVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "compositionRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRepositories",
        "requiredClassifications",
        "holdoutIsolation",
        "secretFree"
      ],
      "properties": {
        "minimumRepositories": {
          "type": "integer",
          "minimum": 3
        },
        "requiredClassifications": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "greenfield",
              "brownfield",
              "mixed-planning-store"
            ]
          }
        },
        "holdoutIsolation": {
          "type": "boolean",
          "const": true
        },
        "secretFree": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/repositoryFixture"
      }
    }
  },
  "$defs": {
    "repositoryFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "classification",
        "planningStoreMode",
        "fixtureVersion",
        "holdout",
        "sourceRevision",
        "remoteUrl",
        "expectedOutcomes"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "greenfield",
            "brownfield",
            "mixed-planning-store"
          ]
        },
        "planningStoreMode": {
          "type": "string",
          "enum": [
            "same-repo",
            "separate-project",
            "mixed"
          ]
        },
        "fixtureVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "holdout": {
          "type": "boolean"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "remoteUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "expectedOutcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "status"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "apiKey"
            ]
          },
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "password"
            ]
          },
          {
            "required": [
              "secret"
            ]
          },
          {
            "required": [
              "credential"
            ]
          }
        ]
      }
    }
  }
}
